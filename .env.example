# Production application settings
NEXUS_ENV=production
NEXUS_LOG_LEVEL=INFO
NEXUS_PUBLIC_URL=https://YOUR_DOMAIN
NEXUS_COOKIE_SECURE=true
NEXUS_EXPOSE_DEV_TOKENS=false

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
